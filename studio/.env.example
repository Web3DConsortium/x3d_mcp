# The existing x3d_mcp Streamable HTTP endpoint. This is only read server-side.
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Render free instances may need extra time to wake from a cold start.
MCP_REQUEST_TIMEOUT_MS=60000

# Override only when the backend is pinned to another supported MCP version.
MCP_PROTOCOL_VERSION=2025-11-25
